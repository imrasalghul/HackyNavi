<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>org.hackynavi.driver.HackyNavi</string>
    <key>CFBundleName</key><string>HackyNavi</string>
    <key>CFBundleExecutable</key><string>HackyNavi</string>
    <key>CFBundlePackageType</key><string>KEXT</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleVersion</key><string>0.1.0</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>IOKitPersonalities</key>
    <dict>
        <key>HackyNavi diagnostic observer</key>
        <dict>
            <key>CFBundleIdentifier</key><string>org.hackynavi.driver.HackyNavi</string>
            <key>IOClass</key><string>HackyNavi</string>
            <key>IOProviderClass</key><string>IOResources</string>
            <key>IOResourceMatch</key><string>IOKit</string>
            <key>IOMatchCategory</key><string>HackyNaviDiagnosticObserver</string>
        </dict>
        <key>HackyNavi experimental Navi 31 device</key>
        <dict>
            <key>CFBundleIdentifier</key><string>org.hackynavi.driver.HackyNavi</string>
            <key>IOClass</key><string>HackyNaviDevice</string>
            <key>IOProviderClass</key><string>IOPCIDevice</string>
            <key>IOPCIPrimaryMatch</key><string>0x744c1002</string>
            <!-- probe() refuses to claim the device without -hackynavi-device.
                 Use the default PCI match category: this is a device owner. -->
        </dict>
    </dict>
    <!-- Darwin 24 is the macOS 15 baseline. No private KPI dependency. -->
    <key>OSBundleLibraries</key>
    <dict>
        <key>com.apple.kpi.iokit</key><string>24.0.0</string>
        <key>com.apple.kpi.libkern</key><string>24.0.0</string>
        <key>com.apple.kpi.mach</key><string>24.0.0</string>
        <key>com.apple.iokit.IOPCIFamily</key><string>2.9</string>
    </dict>
</dict>
</plist>
